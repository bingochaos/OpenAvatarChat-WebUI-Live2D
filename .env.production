# Production build defaults shipped with this branch.
#
# This file is git-tracked on purpose: it makes `pnpm run build` produce a
# dist/ that has Live2D enabled out of the box, so OpenAvatarChat only needs to
# point its frontend submodule at this repo and copy dist/ into
# src/service/frontend_service/frontend/dist/ — no backend change required.
#
# Loaded automatically by `vite build` (mode=production) on top of any local
# `.env`. Mode-specific values win on conflicts, so the empty server settings
# below intentionally neutralise a developer's local `.env` (which usually
# points the dev proxy at 127.0.0.1) — the built client falls back to
# location.* and talks to whatever host actually serves the page.

# Force the Live2D renderer on the client regardless of the backend
# avatar_config (the backend keeps streaming ARKit blendshape + PCM as usual).
VITE_AVATAR_TYPE=live2d

# Default Cubism model loaded on startup. Override per-deploy if needed; the
# in-app model switcher still reads the rest from live2d/models.json.
VITE_LIVE2D_MODEL_URL=./live2d/hiyori/Hiyori.model3.json

# Empty => auto-detect server origin from the browser location.* (same-origin
# with OpenAvatarChat's FastAPI). Do NOT hard code an IP/port/SSL here, or the
# bundled dist would only work for that exact host.
VITE_SERVER_IP=
VITE_SERVER_PORT=
VITE_USE_SSL=
